{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filester-navigator",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Serve the app on your own domain. The zone (snippface.vip) must be on this
  // Cloudflare account; Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "fs.snippface.vip", "custom_domain": true }],
  // Also keep the free *.workers.dev URL as a fallback.
  "workers_dev": true,
  // Encrypted per-user settings (users' own R2 backup credentials) and daily usage
  // counters. No id needed: `wrangler deploy` creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "STORE" }],
  "vars": {
    // Max GB each user may copy into their own bucket per day through this Worker (0 = no cap).
    "BACKUP_DAILY_CAP_GB": "50"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   SESSION_SECRET     – 32+ random characters, encrypts the login cookie.
  //   CREDENTIALS_SECRET – 32+ random characters, encrypts users' stored R2 keys.
  //   ALLOWED_USERS      – optional: Filester usernames allowed to sign in (unset = public).
  //   TURNSTILE_SECRET   – optional: Turnstile secret key; with the TURNSTILE_SITE_KEY var, adds a bot check to sign-in.
}
